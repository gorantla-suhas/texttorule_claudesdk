# ============================================================================
# texttorule_engine — runtime environment
# ============================================================================
# Loaded by app/config.py and app/services/sql_lookup.py. Set values here
# for local dev, or export them in your shell / process manager / docker
# run / k8s manifest for production.
#
# Conventions:
#   - Secrets (API keys, DB password) live here.
#   - Catalog / business config lives in configs/*.yaml.
#   - Code reads env via os.environ.get() with sensible defaults.
# ============================================================================


# ----------------------------------------------------------------------------
# Claude Agent SDK provider (reads natively from env)
# ----------------------------------------------------------------------------
# Pointing at Ollama: SDK reads ANTHROPIC_BASE_URL + ANTHROPIC_API_KEY
# natively. ANTHROPIC_API_KEY is just a placeholder when the URL is Ollama.
# For Anthropic directly, set the real key.

ANTHROPIC_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=ollama

# Optional client identity sent to the SDK.
CLAUDE_AGENT_SDK_CLIENT_APP=texttorule-engine/0.1.0


# ----------------------------------------------------------------------------
# Engine — model + behavior
# ----------------------------------------------------------------------------

# Model names served by the provider above. Check
# `curl http://localhost:11434/api/tags` for what's actually
# available on your Ollama instance.
RULE_ORCHESTRATOR_MODEL=nemotron-3-super:cloud
RULE_SUBAGENT_MODEL=nemotron-3-super:cloud

# Max SDK turns per orchestrator session.
RULE_MAX_TURNS=8

# Verifier mode:
#   none      — skip verification entirely (default)
#   end-only  — invoke verifier once at the end (currently wired)
#   per-step  — invoke verifier after each significant stage (future)
RULE_VERIFIER_MODE=end-only


# ----------------------------------------------------------------------------
# Engine — paths
# ----------------------------------------------------------------------------
# All relative to PROJECT_DIR. Override only if you need absolute paths.

RULE_DATA_DIR=data
RULE_CONFIGS_DIR=configs
RULE_SDK_CONTEXT_DIR=data/sdk_context
RULE_AUDIT_DIR=logs


# ----------------------------------------------------------------------------
# Engine — retrieval tuning
# ----------------------------------------------------------------------------

# Top-K candidates per role (metric / filter / time).
RULE_RETRIEVAL_TOP_K=5

# Hybrid score weights: 0.5 * bm25 + 0.5 * embedding (must sum to 1.0).
RULE_BM25_WEIGHT=0.5
RULE_EMBEDDING_WEIGHT=0.5

# Embedding backend:
#   char_ngram          — built-in, no extra deps (default)
#   sentence-transformers — requires the sentence-transformers package
RULE_EMBEDDING_BACKEND=char_ngram


# ----------------------------------------------------------------------------
# Engine — logging
# ----------------------------------------------------------------------------

RULE_LOG_LEVEL=INFO
RULE_CONSOLE_TRACE=0   # 0 = off, 1 = per-request tool-call trace


# ----------------------------------------------------------------------------
# Database — benefit + final-JSON lookups
# ----------------------------------------------------------------------------
# pyodbc connection string parts. Set DB_PASSWORD at deploy time.

DB_DRIVER=FreeTDS
DB_HOST=10.0.10.24
DB_NAME=Magik_3.0_Demo_Upgrade
DB_USER=magikuser
DB_PASSWORD=magikuser@6Dtech

# Driver notes (T-SQL dialect — TOP 1, IDENTITY, etc.):
#   Windows  → install "ODBC Driver 17 for SQL Server" (Microsoft),
#                set DB_DRIVER="ODBC Driver 17 for SQL Server"
#   Linux    → install FreeTDS + unixODBC,
#                set DB_DRIVER="FreeTDS"
#   macOS    → install FreeTDS via Homebrew,
#                set DB_DRIVER="FreeTDS"
#
# If the deployment machine has neither ODBC nor FreeTDS, swap
# `app/services/sql_lookup.py:_connect()` for the matching driver:
#   pymysql (MySQL/MariaDB; needs `TOP 1` → `LIMIT 1` rewrite)
#   psycopg2 (PostgreSQL; same rewrite)
# No other code changes needed — the SQL functions already isolate
# the connection call behind `_connect()`.

# The four SQL queries (in data/sdk_context/db_details):
#   1. get_product_by_name_or_id       → SELECT TOP 1 ... FROM PROD_PRODUCT_MASTER ...
#   2. get_profile_id                  → SELECT TOP 1 ... FROM RE_BUSINESS_KPIS ...
#   3. get_action_id                   → SELECT TOP 1 ... FROM RE_ACTION_INFO ...
#   4. get_bonus_details               → SELECT TOP 1 ... FROM BONUS_RULE_KPI_DETAILS ...
# When DB env vars are missing or the connection fails, the lookup
# functions return None and the pipeline emits the rule with empty
# IDs (the campaign engine tolerates missing IDs per final-rule-json.md).


# ----------------------------------------------------------------------------
# Langfuse — observability (optional, off by default)
# ----------------------------------------------------------------------------

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development