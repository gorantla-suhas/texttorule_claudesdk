def parse_schedule_block(schedule_str):
    s = schedule_str.strip()
    if not s.lower().startswith("schedule(") or not s.endswith(")"):
        if s.lower().startswith("schedule("):
            _, j = find_balanced(s, "(", ")", s.lower().find("("))
            if j != -1:
                s = s[: j + 1]
        if not s.lower().startswith("schedule(") or not s.endswith(")"):
            raise ValueError(f"Malformed schedule block: {schedule_str}")
    content = s[len("schedule("): -1].strip()
    parts = []
    buf = []
    in_quote = None
    brace_depth = 0  # ✅ NEW: Track { } nesting
    escaped = False

    for ch in content:
        if in_quote:
            buf.append(ch)
            if escaped:
                escaped = False  # Reset after escaped char
            elif ch == "\\":
                escaped = True   # Next char is escaped
            elif ch == in_quote:
                in_quote = None
        else:
            if ch in ('"', "'"):
                in_quote = ch
                buf.append(ch)
            elif ch == "{":
                brace_depth += 1
                buf.append(ch)
            elif ch == "}":
                brace_depth -= 1
                buf.append(ch)
            elif ch == "," and brace_depth == 0:
                parts.append("".join(buf).strip())
                buf = []
            else:
                buf.append(ch)

    if buf:
        parts.append("".join(buf).strip())

    schedule = {}
    for part in parts:
        if not part or "=" not in part:
            continue
        k, v = part.split("=", 1)
        k = k.strip()
        v = v.strip()

        # Remove outer quotes
        if (v.startswith('"') and v.endswith('"')) or (v.startswith("'") and v.endswith("'")):
            v = v[1:-1]

        # ✅ NEW: Check if value is JSON object
        if v.strip().startswith("{") and v.strip().endswith("}"):
            try:
                # Try to parse as JSON
                schedule[k] = json.loads(v)  # Keep as dict for now
            except json.JSONDecodeError:
                schedule[k] = v  # If parsing fails, keep as string
        else:
            schedule[k] = v
    return schedule


