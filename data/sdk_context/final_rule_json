def _smart_kv_split(s: str) -> list[str]:
    parts, buf = [], []
    in_quote = None
    paren_depth = 0
    brace_depth = 0
    i = 0
    while i < len(s):
        ch = s[i]
        if in_quote:
            buf.append(ch)
            if ch == in_quote:
                in_quote = None
        else:
            if ch in ('"', "'"):
                in_quote = ch
                buf.append(ch)
            elif ch == "(":
                paren_depth += 1
                buf.append(ch)
            elif ch == ")":
                paren_depth -= 1
                buf.append(ch)
            elif ch == "{":
                brace_depth += 1
                buf.append(ch)
            elif ch == "}":
                brace_depth -= 1
                buf.append(ch)
            elif ch == "," and paren_depth == 0 and brace_depth == 0:
                parts.append("".join(buf).strip())
                buf = []
            else:
                buf.append(ch)
        i += 1
    if buf:
        parts.append("".join(buf).strip())
    return parts


