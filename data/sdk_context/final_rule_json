def normalize_rule_string(s: str) -> str:
    return re.sub(r"\s+", " ", s).strip()


def find_balanced(text, open_c, close_c, start=0):
    i = text.find(open_c, start)
    if i == -1:
        return -1, -1
    depth = 1
    for j in range(i + 1, len(text)):
        if text[j] == open_c:
            depth += 1
        elif text[j] == close_c:
            depth -= 1
            if depth == 0:
                return i, j
    return -1, -1


def try_cast(val):
    try:
        return int(val)
    except Exception:
        try:
            return float(val)
        except Exception:
            return val


# ============================================================
# Condition parsing (AND/OR/BETWEEN/IN/LIST)
# ============================================================
def parse_conditions(conditions_str: str):
    conditions_str = conditions_str.strip()
    if not conditions_str:
        return {}

    def strip_balanced_parens(s: str) -> str:
        while s.startswith("(") and s.endswith(")"):
            depth = 0
            balanced = True
            for i, c in enumerate(s):
                if c == "(":
                    depth += 1
                elif c == ")":
                    depth -= 1
                    if depth == 0 and i != len(s) - 1:
                        balanced = False
                        break
            if balanced and depth == 0:
                s = s[1:-1].strip()
            else:
                break
        return s

    def smart_split_ignoring_between(s: str):
        """
        Split top-level boolean ANDs, but DO NOT split the AND that belongs to a BETWEEN ... AND ...
        """
        parts = []
        depth = 0
        i = 0
        last = 0
        between_pending = False

        def word_at(pos: int, word: str) -> bool:
            L = len(word)
            if pos < 0 or pos + L > len(s):
                return False
            seg = s[pos: pos + L]
            if seg.lower() != word.lower():
                return False
            if pos > 0 and s[pos - 1].isalnum():
                return False
            if pos + L < len(s) and s[pos + L].isalnum():
                return False
            return True

        while i < len(s):
            ch = s[i]
            if ch == "(":
                depth += 1
                i += 1
                continue
            if ch == ")":
                depth -= 1
                i += 1
                continue

            if depth == 0:
                if word_at(i, "BETWEEN"):
                    between_pending = True
                    i += len("BETWEEN")
                    continue

                if word_at(i, "AND"):
                    if between_pending:
                        between_pending = False
                        i += len("AND")
                        continue
                    else:
                        parts.append(s[last:i].strip())
                        i += len("AND")
                        last = i
                        continue
            i += 1

        parts.append(s[last:].strip())
        return [p for p in parts if p != ""]

    def smart_split_or(s: str):
        parts = []
        depth = 0
        i = 0
        last = 0

        def word_at(pos: int, word: str) -> bool:
            L = len(word)
            if pos < 0 or pos + L > len(s):
                return False
            seg = s[pos: pos + L]
            if seg.lower() != word.lower():
                return False
            if pos > 0 and s[pos - 1].isalnum():
                return False
            if pos + L < len(s) and s[pos + L].isalnum():
                return False
            return True

        while i < len(s):
            ch = s[i]
            if ch == "(":
                depth += 1
                i += 1
                continue
            if ch == ")":
                depth -= 1
                i += 1
                continue
            if depth == 0 and word_at(i, "OR"):
                parts.append(s[last:i].strip())
                i += len("OR")
                last = i
                continue
            i += 1

        parts.append(s[last:].strip())
        return [p for p in parts if p != ""]

    s = strip_balanced_parens(conditions_str)

    or_parts = smart_split_or(s)
    if len(or_parts) > 1:
        return {"OR": [parse_conditions(p) for p in or_parts]}

    and_parts = smart_split_ignoring_between(s)
    if len(and_parts) > 1:
        return {"AND": [parse_conditions(p) for p in and_parts]}

    return parse_simple_condition(s)


def parse_simple_condition(cond: str):
    cond = cond.strip()
    if not cond:
        return {}

    m = re.match(
        r"^(?P<key>.+?)\s+IN\s+LIST\s*\((?P<vals>.+)\)\s*$",
        cond,
        re.IGNORECASE,
    )
    if m:
        key = m.group("key").strip()
        vals = m.group("vals").strip()
        value_list = [v.strip().strip('"').strip("'") for v in _smart_kv_split(vals) if v.strip()]
        return {key: {"in list": value_list}}

    m = re.match(r"^(?P<key>.+?)\s+BETWEEN\s+(?P<rest>.+)$", cond, re.IGNORECASE)
    if m:
        key = m.group("key").strip()
        rest = m.group("rest").strip()
        if re.search(r"\s+AND\s+", rest, re.IGNORECASE):
            frm, to = re.split(r"\s+AND\s+", rest, maxsplit=1, flags=re.IGNORECASE)
            frm, to = frm.strip().strip('"').strip("'"), to.strip().strip('"').strip("'")
        else:
            frm, to = rest.strip().strip('"').strip("'"), ""
        return {key: {"between": [try_cast(frm), try_cast(to)]}}

    if re.search(r"\sIN\s", cond, re.IGNORECASE):
        left, right = re.split(r"\sIN\s", cond, maxsplit=1, flags=re.IGNORECASE)
        key = left.strip()
        value = right.strip()
        if (value.startswith("[") and value.endswith("]")) or (value.startswith("(") and value.endswith(")")):
            value = value[1:-1]
        value_list = [v.strip().strip('"').strip("'") for v in _smart_kv_split(value) if v.strip()]
        return {key: {"in": value_list}}

    for op in [">=", "<=", ">", "<", "=", "<>"]:
        token = f" {op} "
        if token in cond:
            key, value = cond.split(token, 1)
            value = value.strip().strip('"').strip("'")
            if op == "=":
                return {key.strip(): try_cast(value)}
            return {key.strip(): {op: try_cast(value)}}

    raise ValueError(f"Cannot parse condition: {cond}")


